FROM php:8.4-fpm-bookworm

WORKDIR /var/www/html

RUN apt-get update \
    && apt-get install -y --no-install-recommends libonig-dev libsqlite3-dev unzip git \
    && docker-php-ext-install -j"$(nproc)" mbstring pdo_mysql pdo_sqlite \
    && apt-get purge -y --auto-remove libonig-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY docker/php/entrypoint.development.sh /usr/local/bin/entrypoint.development.sh
RUN chmod +x /usr/local/bin/entrypoint.development.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.development.sh"]
CMD ["php-fpm", "-F"]
